{
	"name": "agentkogei",
	"version": "0.1.0",
	"description": "Design systems for AI coding agents, delivered as durable Design Contracts.",
	"keywords": [
		"ai",
		"ai-coding-agents",
		"design-contract",
		"design-system",
		"design-systems",
		"shadcn",
		"tailwind-css"
	],
	"homepage": "https://agentkogei.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arjayby/agentkogei.git",
		"directory": "packages/design-systems"
	},
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"bin": {
		"agentkogei": "./dist/agentkogei.js"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && bun build ./src/install-cli.ts --target=node --outfile=./dist/agentkogei.js",
		"check-types": "tsc --noEmit",
		"distribution:package": "bun run build && bun run scripts/build-package-archive.ts",
		"test": "bun test --timeout 30000",
		"validate": "bun run src/cli.ts"
	},
	"devDependencies": {
		"@agentkogei/config": "workspace:*",
		"typescript": "catalog:",
		"zod": "catalog:"
	}
}
