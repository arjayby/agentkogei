{
	"name": "agentkogei-monorepo",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.4.3",
			"typescript": "^6",
			"lucide-react": "^1.23.0",
			"next": "^16.2.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.7",
			"react-dom": "^19.2.7",
			"@tailwindcss/postcss": "^4.3.2",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.2"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"format:check": "files=$(printf '%s\\n%s' \"$(git diff --name-only --diff-filter=ACMR main --)\" \"$(git ls-files --others --exclude-standard)\" | sed '/^$/d' | sort -u); if test -z \"$files\"; then exit 0; else biome check --no-errors-on-unmatched $files; fi",
		"release:audit": "bun run scripts/audit-release.ts",
		"launch:verify": "bun run format:check && bun run release:audit && bun run check-types && bun run build && bun run test",
		"dev:web": "turbo run dev -F web",
		"deploy:setup": "vercel link",
		"dev:vercel": "vercel dev -L",
		"deploy": "vercel deploy",
		"deploy:prod": "vercel deploy --prod",
		"deploy:check": "vercel deploy --dry",
		"check": "biome check --write .",
		"prepare": "husky"
	},
	"devDependencies": {
		"@agentkogei/config": "workspace:*",
		"@biomejs/biome": "^2.5.2",
		"@types/node": "^22.13.14",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.7",
		"turbo": "^2.10.2",
		"typescript": "catalog:",
		"vercel": "^54.18.6"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write"
		]
	},
	"packageManager": "bun@1.3.13"
}
